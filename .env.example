# Copy to .env and fill in. NEVER commit .env.

# Slack app tokens — from api.slack.com/apps → your Mouthpiece app.
#   App Settings → Socket Mode → enable, then "Generate Level 1 token"  → SLACK_APP_TOKEN
#   Install App (OAuth) → copy "Bot User OAuth Token"                    → SLACK_BOT_TOKEN
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# The magic channel + you.
#   Channel: click the channel, right-click its name → "Copy link" → the C... part
#   User:    click your avatar → "View full profile" → the U... is in the URL
MOUTHPIECE_CHANNEL_ID=C...
MOUTHPIECE_USER_ID=U...

# TTS provider: macos-say (free test, uses a Mac system voice) | elevenlabs (your clone) | xtts (coming)
TTS_PROVIDER=macos-say

# ElevenLabs — https://elevenlabs.io → VoiceLab → Instant Voice Cloning (add your recording) → grab voice ID + API key from your profile
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = fast/low-latency | eleven_multilingual_v2 = higher quality
ELEVENLABS_MODEL=eleven_flash_v2_5

# The virtual audio device we play the voice into (macOS BlackHole).
BLACKHOLE_DEVICE=BlackHole 2ch

# Optional: emoji the bot reacts with when it picks up your message. Blank = off.
MOUTHPIECE_REACT_EMOJI=loud_sound

# Longest message it will speak, in characters.
MOUTHPIECE_MAX_CHARS=500